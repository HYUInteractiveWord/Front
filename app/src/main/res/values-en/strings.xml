    <!-- Tutorials -->
    <string name="tutorial_home_title">Welcome!</string>
    <string name="tutorial_home_body">Customize your profile and check today\'s missions. Tap the tabs at the bottom to start scanning or searching the dictionary.</string>
    <string name="tutorial_dictionary_title">Using Dictionary Search</string>
    <string name="tutorial_dictionary_body">Search for words you\'re curious about and tap the + button to add them to your collection! You can collect them after verifying your pronunciation.</string>
    <string name="tutorial_scan_title">Starting Word Scan</string>
    <string name="tutorial_scan_body">Automatically finds Korean words from surrounding sounds or video media. Try selecting the microphone or a gallery video.</string>
    <string name="tutorial_word_card_title">Manage My Collection</string>
    <string name="tutorial_word_card_body">Check the meaning, translation, and examples of collected words, and hear correct pronunciation via TTS. You can also practice by pronouncing them yourself.</string>
